{
  "entities": {
    "Business": {
      "title": "Business",
      "description": "Enterprise workspace representation for South African micro-businesses.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "businessType": { "type": "string" },
        "townOrCity": { "type": "string" },
        "province": { "type": "string" },
        "offerType": { "type": "string" },
        "currency": { "type": "string" },
        "startingCashBalance": { "type": "number" },
        "contactPhone": { "type": "string" },
        "contactEmail": { "type": "string" },
        "address": { "type": "string" },
        "description": { "type": "string" },
        "publicCatalogueSlug": { "type": "string" },
        "allowNegativeStock": { "type": "boolean" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string" },
        "isDemo": { "type": "boolean" }
      },
      "required": ["id", "name", "businessType", "townOrCity", "province", "currency"]
    },
    "Product": {
      "title": "Product",
      "description": "Stock inventory item with pricing, safety thresholds, and unit costs.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "sellingPrice": { "type": "number" },
        "unitCost": { "type": "number" },
        "currentQuantity": { "type": "number" },
        "minimumSafetyStock": { "type": "number" },
        "unit": { "type": "string" },
        "sku": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "businessId", "name", "category", "sellingPrice", "currentQuantity"]
    },
    "Sale": {
      "title": "Sale",
      "description": "Till or invoice transaction event.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "date": { "type": "string" },
        "customerName": { "type": "string" },
        "subtotal": { "type": "number" },
        "total": { "type": "number" },
        "paidAmount": { "type": "number" },
        "paymentStatus": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "isVoided": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "businessId", "invoiceNumber", "date", "total", "paymentStatus", "paymentMethod"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Operating overhead or supplier inventory payout.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "category": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "description": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "isVoided": { "type": "boolean" }
      },
      "required": ["id", "businessId", "category", "amount", "date", "description", "paymentMethod"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer record with credit debt balance.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "outstandingBalance": { "type": "number" },
        "creditLimit": { "type": "number" }
      },
      "required": ["id", "businessId", "name"]
    }
  },
  "firestore": {
    "/businesses/{businessId}": {
      "schema": "Business",
      "description": "Individual business workspaces."
    },
    "/businesses/{businessId}/products/{productId}": {
      "schema": "Product",
      "description": "Inventory product items belonging to a business."
    },
    "/businesses/{businessId}/sales/{saleId}": {
      "schema": "Sale",
      "description": "Completed or recorded sales."
    },
    "/businesses/{businessId}/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Recorded business overhead expenses."
    },
    "/businesses/{businessId}/customers/{customerId}": {
      "schema": "Customer",
      "description": "Registered customers and credit book entries."
    }
  }
}
